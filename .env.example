# Root reference file — actual values live in backend/.env and frontend/.env
# (each copied from its own .env.example). Documented here for a single overview.

# --- backend/.env ---
# DATABASE_URL: Postgres connection string used by GORM.
#   Local (matches docker-compose.yml): postgres://tracker:tracker@localhost:5433/tracker?sslmode=disable
#   (mapped to host port 5433, not 5432, in case a native Postgres install is already using 5432)
DATABASE_URL=postgres://tracker:tracker@localhost:5433/tracker?sslmode=disable

# JWT_SECRET: HMAC signing secret for access tokens. Use a long random string; rotate per environment.
JWT_SECRET=change-me-to-a-long-random-string

# PORT: local HTTP server port (cmd/local only — unused in Lambda).
PORT=8080

# --- frontend/.env ---
# EXPO_PUBLIC_API_URL: base URL the app calls.
#   Local dev (web): http://localhost:8080
#   Local dev (physical device): http://<your-lan-ip>:8080
#   Production: the deployed API Gateway invoke URL
EXPO_PUBLIC_API_URL=http://localhost:8080
