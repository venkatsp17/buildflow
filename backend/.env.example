DATABASE_URL=postgres://tracker:tracker@localhost:5433/tracker?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080

# CORS_ALLOWED_ORIGINS: comma-separated list of origins allowed to call the API,
# or "*" for any origin (fine for local dev / a base setup; narrow this down
# to your actual web app origin(s) before going to production).
CORS_ALLOWED_ORIGINS=*
