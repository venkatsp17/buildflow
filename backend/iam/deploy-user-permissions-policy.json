{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ListChangeSets"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-south-1:ACCOUNT_ID:stack/STACK_NAME/*",
        "arn:aws:cloudformation:ap-south-1:ACCOUNT_ID:stack/STACK_NAME*/*"
      ]
    },
    {
      "Sid": "CloudFormationTemplateIntrospection",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheCfnExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/STACK_NAME-cfn-exec-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "cloudformation.amazonaws.com" }
      }
    },
    {
      "Sid": "DeploymentArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::STACK_NAME-sam-artifacts",
        "arn:aws:s3:::STACK_NAME-sam-artifacts/*"
      ]
    },
    {
      "Sid": "ReadOwnFunctionForLocalTesting",
      "Effect": "Allow",
      "Action": ["lambda:GetFunction", "lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:ap-south-1:ACCOUNT_ID:function:STACK_NAME-*"
    }
  ]
}
