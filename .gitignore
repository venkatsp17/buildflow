# Backend (Go)
backend/tmp/
backend/*.exe
backend/bin/
backend/.env
backend/.aws-sam/
# sam deploy --guided persists --parameter-overrides here, including the
# plaintext Supabase DatabaseUrl — never commit it.
backend/samconfig.toml
# Generated by the backend/iam/README.md bootstrap (policy templates with
# your account ID substituted in) — local scratch files, not source.
backend/iam/*.filled.json

# Frontend (Expo / Node)
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/.env

# General
.DS_Store
*.log
